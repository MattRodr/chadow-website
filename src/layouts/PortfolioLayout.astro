---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Logo from "../components/Logo.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import Lightbox from "../components/Lightbox.astro";
import { site } from "../data/site";
import { getLang, localePath } from "../i18n/utils";

interface Props {
  title: string;
  description?: string;
}
const { title, description = site.description } = Astro.props;

const lang = getLang(Astro);
const lp = (p: string) => localePath(lang, p);
const pageTitle = `${title} · ${site.name}`;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  {/* Hidden page: never indexed by search engines */}
  <meta name="robots" content="noindex, nofollow" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <ClientRouter />
  <script>
    import "../scripts/reveal.ts";
  </script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="np-header">
    <a href={lp("/")} class="np-brand" aria-label={`${site.name} — home`}>
      <Logo size={34} />
      <span class="np-brand__name">{site.name}</span>
    </a>
    <LanguageSwitcher />
  </header>

  <main id="main" class="np-main">
    <slot />
  </main>

  <footer class="np-footer">
    <p>© {new Date().getFullYear()} {site.name} — {site.owner}</p>
    <a href={`mailto:${site.email}`}>{site.email}</a>
  </footer>

  <Lightbox />

  <style>
    .np-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 22px clamp(20px, 5vw, 64px);
      border-bottom: 1px solid var(--color-border);
      position: sticky;
      top: 0;
      z-index: 30;
      background: rgba(0, 0, 0, 0.8);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
    .np-brand { display: inline-flex; align-items: center; gap: 10px; }
    .np-brand__name {
      font-family: var(--font-display);
      font-size: 18px;
      letter-spacing: 0.08em;
    }

    .np-main {
      max-width: 1100px;
      margin: 0 auto;
      padding: clamp(40px, 7vw, 88px) clamp(20px, 5vw, 64px) 80px;
    }

    .np-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
      padding: 28px clamp(20px, 5vw, 64px);
      border-top: 1px solid var(--color-border);
      font-size: 13px;
      color: var(--color-text-mute);
    }
    .np-footer a { color: var(--color-text); }
    .np-footer a:hover { opacity: 0.7; }
  </style>
</body>
</html>
