---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import AboutHeader from "../components/AboutHeader.astro";
import AboutManifesto from "../components/AboutManifesto.astro";
import AboutStory from "../components/AboutStory.astro";
import Soundtrack from "../components/Soundtrack.astro";
import KeyNumbers from "../components/KeyNumbers.astro";
import InstagramTeaser from "../components/InstagramTeaser.astro";
import FinalCTA from "../components/FinalCTA.astro";
import { getLang, getT } from "../i18n/utils";
const lang = getLang(Astro);
const t = getT(lang);
---
<BaseLayout title={t.nav.about}>
  <Section noBorder>
    <AboutHeader />
  </Section>

  <Section size="lg">
    <AboutManifesto />
  </Section>

  <Section>
    <AboutStory />
  </Section>

  <Section noBorder>
    <Soundtrack />
  </Section>

  <Section label={t.sections.keyNumbers.label} title={t.sections.keyNumbers.title}>
    <KeyNumbers variant="grid" />
  </Section>

  <InstagramTeaser />

  <Section size="lg">
    <FinalCTA />
  </Section>
</BaseLayout>
