---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import PortfolioGrid from "../components/PortfolioGrid.astro";
import FinalCTA from "../components/FinalCTA.astro";
import { getLang, getT } from "../i18n/utils";
const lang = getLang(Astro);
const t = getT(lang);
---
<BaseLayout title={t.nav.work}>
  <Section noBorder>
    <header class="work-intro">
      <p class="eyebrow">{t.work.eyebrow}</p>
      <h1 class="work-intro__title">
        {t.work.title.map((line, i) => <>{i > 0 && <br />}{line}</>)}
      </h1>
      <p class="work-intro__lead">{t.work.lead}</p>
    </header>
  </Section>

  <Section noBorder size="sm">
    <PortfolioGrid />
  </Section>

  <Section size="lg">
    <FinalCTA />
  </Section>
</BaseLayout>

<style>
  .work-intro { max-width: 760px; padding: 24px 0 8px; }
  .eyebrow {
    font-size: 11px;
    letter-spacing: var(--ls-extra);
    text-transform: uppercase;
    color: var(--color-text-mute);
    margin: 0 0 24px;
  }
  .work-intro__title {
    font-family: var(--font-display);
    font-size: var(--fs-display);
    line-height: 0.9;
    letter-spacing: 0.005em;
    margin: 0 0 24px;
    text-transform: uppercase;
  }
  .work-intro__lead { margin: 0; font-size: 16px; color: var(--color-text-dim); line-height: 1.7; max-width: 56ch; }
  @media (max-width: 760px) {
    .work-intro { padding: 8px 0 4px; }
    .work-intro .eyebrow { font-size: 13px; letter-spacing: 0.28em; }
    .work-intro__title { font-size: clamp(56px, 14vw, 84px); }
    .work-intro__lead { font-size: 17px; line-height: 1.7; }
  }
</style>
