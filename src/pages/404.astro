---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Logo from "../components/Logo.astro";
import { getLang, getT, localePath } from "../i18n/utils";

const lang = getLang(Astro);
const t = getT(lang);
const isFr = lang === "fr";

const heading = isFr ? "Page introuvable" : "Page not found";
const body = isFr
  ? "La page que vous cherchez n'existe pas ou a été déplacée."
  : "The page you're looking for doesn't exist or has moved.";
const ctaHome = isFr ? "Retour à l'accueil" : "Back to home";
const ctaWork = isFr ? "Voir le portfolio" : "View portfolio";
---
<BaseLayout title="404" description={body} noindex={true}>
  <section class="notfound">
    <div class="notfound__inner">
      <div class="notfound__logo"><Logo size={56} /></div>
      <p class="notfound__code">404</p>
      <h1 class="notfound__title">{heading}</h1>
      <p class="notfound__body">{body}</p>
      <div class="notfound__actions">
        <Button href={localePath(lang, "/")} variant="solid">{ctaHome}</Button>
        <Button href={localePath(lang, "/work")} variant="outline">{ctaWork}</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    min-height: calc(100vh - 120px);
    display: grid;
    place-items: center;
    padding: 60px 0;
  }
  .notfound__inner {
    text-align: center;
    max-width: 520px;
  }
  .notfound__logo {
    display: inline-flex;
    margin-bottom: 28px;
    opacity: 0.9;
  }
  .notfound__code {
    font-family: var(--font-display);
    font-size: clamp(72px, 14vw, 140px);
    line-height: 1;
    margin: 0 0 12px;
    color: var(--color-text-mute);
    letter-spacing: 0.02em;
  }
  .notfound__title {
    font-family: var(--font-display);
    font-size: clamp(28px, 4vw, 40px);
    margin: 0 0 14px;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  .notfound__body {
    color: var(--color-text-dim);
    margin: 0 0 28px;
    font-size: 15px;
    line-height: 1.6;
  }
  .notfound__actions {
    display: inline-flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }
</style>
