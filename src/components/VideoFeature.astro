---
import { services } from "../data/site";
import { loopEmbed } from "../utils/video";
import { getLang, getT, localePath } from "../i18n/utils";

const lang = getLang(Astro);
const t = getT(lang);
const lp = (p: string) => localePath(lang, p);

const service = services.find((s) => s.slug === "video-content")!;
const item = t.services.items["video-content"];
const v = loopEmbed((service as { video?: string }).video);
const poster = service.detailImage || service.cardImage;
---
<div class="vf" data-reveal="up">
  <div class="vf__media">
    {v?.provider === "file" ? (
      <video class="vf__player" src={v.src} poster={poster} autoplay muted loop playsinline preload="metadata"></video>
    ) : v ? (
      <iframe class="vf__player" src={v.embed} title={item.title} loading="lazy" frameborder="0" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
    ) : (
      <img class="vf__player" src={poster} alt={item.title} loading="lazy" />
    )}
  </div>

  <div class="vf__text">
    <p class="vf__eyebrow">{t.services.items["video-content"].title}</p>
    <h3 class="vf__title">{t.services.items["video-content"].description}</h3>
    <a class="vf__cta" href={lp("/services")}>
      {t.cta.discussVideo}
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="4" y1="12" x2="20" y2="12"/>
        <polyline points="14 6 20 12 14 18"/>
      </svg>
    </a>
  </div>
</div>

<style>
  .vf {
    margin-top: 18px;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .vf__media {
    aspect-ratio: 16 / 9;
    background: #0e0e0e;
    overflow: hidden;
  }
  .vf__player {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    object-fit: cover;
  }

  .vf__text {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(24px, 3vw, 40px) clamp(24px, 3vw, 44px) clamp(24px, 3vw, 40px) 0;
  }
  .vf__eyebrow {
    margin: 0;
    font-size: 11px;
    letter-spacing: var(--ls-extra);
    text-transform: uppercase;
    color: var(--color-text-mute);
  }
  .vf__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(26px, 2.8vw, 40px);
    line-height: 1.02;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }
  .vf__cta {
    margin-top: 8px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--color-text-mute);
    transition: color var(--dur-fast) var(--ease);
  }
  .vf__cta:hover { color: var(--color-text); }
  .vf__cta svg { transition: transform var(--dur) var(--ease); }
  .vf__cta:hover svg { transform: translateX(3px); }

  @media (max-width: 900px) {
    .vf { grid-template-columns: 1fr; gap: 0; }
    .vf__text { padding: 24px 24px 28px; gap: 12px; }
  }
  @media (max-width: 760px) {
    .vf__title { font-size: clamp(28px, 8vw, 38px); }
  }
</style>
