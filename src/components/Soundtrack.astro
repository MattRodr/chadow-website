---
import { site, featuredImages } from "../data/site";
import { getLang, getT } from "../i18n/utils";
const lang = getLang(Astro);
const t = getT(lang);
const s = t.about.soundtrack;
---
<section class="soundtrack" aria-labelledby="soundtrack-title">
  <img src={featuredImages.soundtrackBg} alt="" class="soundtrack__bg" loading="lazy" aria-hidden="true" />
  <div class="soundtrack__inner">
    <p class="soundtrack__eyebrow">{s.label}</p>
    <h2 class="soundtrack__title" id="soundtrack-title">{s.paragraphs[0]}</h2>
    {s.paragraphs[1] && <p class="soundtrack__lead">{s.paragraphs[1]}</p>}

    <a class="soundtrack__cta" href={site.spotifyPlaylist} target="_blank" rel="noopener">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.586 14.424a.623.623 0 0 1-.857.207c-2.348-1.435-5.304-1.76-8.785-.964a.622.622 0 1 1-.277-1.215c3.809-.871 7.077-.496 9.712 1.115a.623.623 0 0 1 .207.857zm1.223-2.722a.78.78 0 0 1-1.072.257c-2.687-1.652-6.785-2.131-9.965-1.166a.78.78 0 1 1-.452-1.493c3.632-1.102 8.147-.568 11.232 1.328a.78.78 0 0 1 .257 1.073zm.105-2.835C14.692 8.95 9.375 8.775 6.298 9.71a.935.935 0 1 1-.542-1.79c3.532-1.072 9.404-.865 13.115 1.338a.936.936 0 0 1-.956 1.61z"/>
      </svg>
      <span>{s.cta}</span>
      <svg class="soundtrack__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/>
      </svg>
    </a>
  </div>
</section>

<style>
  .soundtrack {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    isolation: isolate;
    min-height: clamp(380px, 56vh, 600px);
    display: flex;
    align-items: center;
  }
  .soundtrack__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .soundtrack::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.6) 45%, rgba(0,0,0,0.25) 100%);
  }

  .soundtrack__inner {
    padding: clamp(32px, 5vw, 72px);
    max-width: 760px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }
  .soundtrack__eyebrow {
    margin: 0;
    font-size: 11px;
    letter-spacing: var(--ls-extra);
    text-transform: uppercase;
    color: var(--color-text-mute);
  }
  .soundtrack__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(38px, 5.4vw, 78px);
    line-height: 0.95;
    letter-spacing: 0.005em;
    text-transform: uppercase;
    max-width: 18ch;
  }
  .soundtrack__lead {
    margin: 0;
    font-size: clamp(15px, 1.5vw, 17px);
    line-height: 1.7;
    color: var(--color-text-dim);
    max-width: 48ch;
  }

  .soundtrack__cta {
    margin-top: 10px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 14px 22px;
    border-radius: 999px;
    background: #1db954;
    color: #0a0a0a;
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.01em;
    transition: transform var(--dur) var(--ease), filter var(--dur-fast) var(--ease);
  }
  .soundtrack__cta:hover { transform: translateY(-1px); filter: brightness(1.08); }
  .soundtrack__arrow { transition: transform var(--dur) var(--ease); }
  .soundtrack__cta:hover .soundtrack__arrow { transform: translate(2px, -2px); }

  @media (max-width: 760px) {
    .soundtrack { border-radius: var(--radius); min-height: clamp(440px, 70vh, 600px); }
    .soundtrack::after {
      background: linear-gradient(180deg, rgba(0,0,0,0.45) 0%, rgba(0,0,0,0.85) 100%);
    }
    .soundtrack__inner { padding: 32px 26px; }
    .soundtrack__lead { font-size: 16px; }
    .soundtrack__cta { padding: 16px 24px; font-size: 15px; }
  }
</style>
