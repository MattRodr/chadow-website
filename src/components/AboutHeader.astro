---
import { site, aboutCarousel } from "../data/site";
import { getLang, getT } from "../i18n/utils";
const lang = getLang(Astro);
const t = getT(lang);

// Carrousel « Ambre en train de shooter » : la 1ʳᵉ photo s'affiche,
// les autres sont des déclencheurs cachés du même groupe → le Lightbox
// global permet de toutes les feuilleter au clic.
const shots = aboutCarousel.length ? aboutCarousel : [];
const hasMore = shots.length > 1;
---
<div class="hero">
  <div class="hero__text">
    <p class="hero__eyebrow">{t.about.eyebrow}</p>
    <h1 class="hero__title">{t.about.title}</h1>
    <p class="hero__subtitle">{t.about.subtitle}</p>

    <div class="hero__links">
      <a class="pill pill--spotify" href={site.spotifyPlaylist} target="_blank" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.586 14.424a.623.623 0 0 1-.857.207c-2.348-1.435-5.304-1.76-8.785-.964a.622.622 0 1 1-.277-1.215c3.809-.871 7.077-.496 9.712 1.115a.623.623 0 0 1 .207.857zm1.223-2.722a.78.78 0 0 1-1.072.257c-2.687-1.652-6.785-2.131-9.965-1.166a.78.78 0 1 1-.452-1.493c3.632-1.102 8.147-.568 11.232 1.328a.78.78 0 0 1 .257 1.073zm.105-2.835C14.692 8.95 9.375 8.775 6.298 9.71a.935.935 0 1 1-.542-1.79c3.532-1.072 9.404-.865 13.115 1.338a.936.936 0 0 1-.956 1.61z"/>
        </svg>
        <span>{t.about.spotifyLabel}</span>
      </a>
      {site.linkedinPersonal && (
        <a class="pill" href={site.linkedinPersonal} target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.4c0-1.29-.02-2.95-1.8-2.95-1.8 0-2.07 1.4-2.07 2.85V21H9z"/>
          </svg>
          <span>{t.about.linkedinLabel}</span>
        </a>
      )}
    </div>
  </div>

  {shots.length > 0 && (
    <div class="hero__media">
      <figure
        class="hero__shot"
        data-lightbox-trigger
        data-lightbox-group="about-shooting"
        data-lightbox-caption={shots[0].context || shots[0].alt}
      >
        <img src={shots[0].src} alt={shots[0].alt} loading="eager" />
        {hasMore && (
          <figcaption class="hero__shot-hint">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M21 14v7H3V3h7"/>
            </svg>
            <span>{t.about.carouselHint} · {shots.length}</span>
          </figcaption>
        )}
      </figure>
      {hasMore && shots.slice(1).map((s) => (
        <figure
          class="hero__shot-hidden"
          data-lightbox-trigger
          data-lightbox-group="about-shooting"
          data-lightbox-caption={s.context || s.alt}
          aria-hidden="true"
        >
          <img src={s.src} alt={s.alt} loading="lazy" />
        </figure>
      ))}
    </div>
  )}
</div>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(300px, 38%, 440px);
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
    max-width: 1160px;
  }
  .hero__text { display: flex; flex-direction: column; gap: 20px; }

  .hero__eyebrow {
    font-size: 11px;
    letter-spacing: var(--ls-extra);
    text-transform: uppercase;
    color: var(--color-text-mute);
    margin: 0;
  }
  .hero__title {
    font-family: var(--font-display);
    font-size: var(--fs-display);
    line-height: 0.9;
    letter-spacing: 0.005em;
    margin: 0;
    text-transform: uppercase;
  }
  .hero__subtitle {
    margin: -6px 0 0;
    font-size: clamp(14px, 1.4vw, 16px);
    letter-spacing: 0.03em;
    color: var(--color-text-dim);
    max-width: 34ch;
  }

  .hero__links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 10px 16px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--color-text-dim);
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
  }
  .pill:hover { color: var(--color-text); border-color: var(--color-border-strong); background: rgba(255,255,255,0.04); }
  .pill--spotify svg { color: #1db954; }
  .pill:not(.pill--spotify) svg { color: #0a66c2; }

  .hero__media { margin: 0; }
  .hero__shot {
    position: relative;
    margin: 0;
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    overflow: hidden;
    background: #0e0e0e;
    cursor: zoom-in;
  }
  .hero__shot img {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
    transition: transform 1200ms cubic-bezier(.2,.7,.2,1);
  }
  .hero__shot:hover img { transform: scale(1.04); }
  .hero__shot-hint {
    position: absolute;
    left: 14px; bottom: 14px;
    display: inline-flex; align-items: center; gap: 8px;
    padding: 8px 13px;
    border-radius: 999px;
    background: rgba(0,0,0,0.55);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase;
  }
  .hero__shot-hidden { display: none; }

  @media (max-width: 1024px) {
    .hero { grid-template-columns: 1fr; gap: 28px; }
    .hero__media { order: -1; max-width: 420px; }
  }
  @media (max-width: 760px) {
    .hero__title { font-size: clamp(64px, 18vw, 96px); }
    .hero__eyebrow { font-size: 13px; letter-spacing: 0.28em; }
    .hero__subtitle { font-size: 17px; }
    .hero__links .pill { font-size: 13px; padding: 11px 17px; }
    .hero__media { max-width: 100%; }
  }
</style>
