---
import { recentPhotos } from "../data/site";

// Use 6 slots — repeat the strongest photo if fewer than 6 are provided
const photos = recentPhotos.length >= 6 ? recentPhotos.slice(0, 6) : [...recentPhotos, recentPhotos[0]];
---
<div class="recent-work">
  <ul class="grid">
    {photos.map((p, i) => (
      <li class="grid__item" data-reveal="up" data-reveal-delay={i * 90}>
        <figure
          class="recent-figure"
          data-lightbox-trigger
          data-lightbox-group="home"
          data-lightbox-caption={p.context}
        >
          <img src={p.src} alt={p.alt} loading="lazy" />
          <figcaption class="recent-figure__caption">{p.context}</figcaption>
        </figure>
      </li>
    ))}
  </ul>

  <a href="/work" class="view-link">
    <span>View portfolio</span>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="4" y1="12" x2="20" y2="12"/>
      <polyline points="14 6 20 12 14 18"/>
    </svg>
  </a>
</div>

<style>
  .recent-work { display: flex; flex-direction: column; gap: 28px; }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .grid__item { overflow: hidden; }

  .recent-figure {
    position: relative;
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 1 / 1;
  }
  .recent-figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease);
  }
  .recent-figure:hover img { transform: scale(1.05); }

  .recent-figure__caption {
    position: absolute;
    inset: auto 0 0 0;
    padding: 14px 16px 12px;
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--color-text);
    background: linear-gradient(to top, rgba(0,0,0,0.85), transparent);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .recent-figure:hover .recent-figure__caption {
    opacity: 1;
    transform: translateY(0);
  }

  .view-link {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-size: 11px;
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--color-text);
    padding: 4px 0;
    transition: opacity var(--dur-fast) var(--ease);
  }
  .view-link svg { transition: transform var(--dur) var(--ease); }
  .view-link:hover svg { transform: translateX(4px); }

  @media (max-width: 900px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; gap: 16px; }
    .recent-figure { aspect-ratio: 4 / 3; }
    .recent-figure__caption {
      opacity: 1;
      transform: translateY(0);
      padding: 18px 20px 16px;
      font-size: 13px;
      letter-spacing: 0.06em;
    }
    .view-link {
      font-size: 13px;
      padding: 8px 0;
    }
  }
</style>
