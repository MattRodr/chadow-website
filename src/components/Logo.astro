---
import { brandLogo } from "../data/photos";
interface Props {
  size?: number;
}
const { size = 40 } = Astro.props;
---
<span class="logo" style={`width:${size}px;height:${size}px;`} aria-hidden="true">
  <img src={brandLogo} alt="" loading="eager" decoding="sync" />
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    /* Invert dark logo to white on dark background; keep mint accent subtle. */
    filter: invert(1) hue-rotate(180deg);
  }
</style>
