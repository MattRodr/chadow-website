---
import { homePhotos } from "../data/site";

interface Photo {
  src: string;
  alt: string;
}
interface Props {
  photos?: Photo[];
}

const { photos = homePhotos } = Astro.props;
---
<div class="gallery">
  <div class="marquee">
    <div class="marquee__track">
      {[...photos, ...photos].map((item, idx) => {
        const isClone = idx >= photos.length;
        return (
          <figure
            class="tile"
            aria-hidden={isClone ? "true" : "false"}
            data-lightbox-trigger={isClone ? undefined : ""}
            data-lightbox-group={isClone ? undefined : "hero"}
            data-lightbox-caption={isClone ? undefined : (item as any).context || item.alt}
          >
            <img
              src={item.src}
              alt={item.alt}
              loading={idx < 4 ? "eager" : "lazy"}
              fetchpriority={idx === 0 ? "high" : undefined}
              decoding={idx < 4 ? "sync" : "async"}
              class="tile__media"
            />
          </figure>
        );
      })}
    </div>
  </div>
</div>

<script>
  document.addEventListener("visibilitychange", () => {
    const track = document.querySelector<HTMLElement>(".marquee__track");
    if (!track) return;
    track.style.animationPlayState = document.hidden ? "paused" : "running";
  });
</script>

<style>
  .gallery {
    position: relative;
    height: clamp(520px, 78vh, 760px);
    border-radius: var(--radius-lg);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 8%, #000 92%, transparent 100%);
            mask-image: linear-gradient(to bottom, transparent 0%, #000 8%, #000 92%, transparent 100%);
  }
  .marquee {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .marquee__track {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: minmax(240px, 30vh);
    gap: 16px;
    width: 100%;
    animation: scroll-y 42s linear infinite;
    will-change: transform;
  }
  @keyframes scroll-y {
    from { transform: translateY(0); }
    to   { transform: translateY(-50%); }
  }
  .marquee:hover .marquee__track { animation-play-state: paused; }

  .tile {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    background: #111;
  }
  .tile__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease);
  }
  .tile:hover .tile__media { transform: scale(1.04); }

  @media (max-width: 1100px) {
    .gallery { height: clamp(440px, 64vh, 600px); }
  }
  @media (max-width: 760px) {
    .gallery { height: clamp(520px, 80vh, 640px); }
    .marquee__track {
      grid-template-columns: 1fr;
      grid-auto-rows: clamp(280px, 60vw, 360px);
      gap: 14px;
    }
  }
</style>
