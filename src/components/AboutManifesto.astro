---
import { getLang, getT } from "../i18n/utils";
const lang = getLang(Astro);
const t = getT(lang);
const intro = t.about.intro;
// intro[0..1] = punch ; intro[2..] = phrases d'appui
const headline = intro.slice(0, 2);
const support = intro.slice(2);
---
<div class="manifesto">
  <h2 class="manifesto__headline" data-reveal>
    {headline.map((line, i) => <>{i > 0 && <br />}{line}</>)}
  </h2>
  <div class="manifesto__support" data-reveal data-reveal-delay="100">
    {support.map((p) => <p>{p}</p>)}
  </div>
</div>

<style>
  .manifesto {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 28px;
    max-width: 880px;
    margin: 0 auto;
  }
  .manifesto__headline {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(34px, 5vw, 68px);
    line-height: 0.98;
    letter-spacing: 0.005em;
    text-transform: uppercase;
  }
  .manifesto__support {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 60ch;
  }
  .manifesto__support p {
    margin: 0;
    font-size: clamp(16px, 1.5vw, 18px);
    line-height: 1.7;
    color: var(--color-text-dim);
  }

  @media (max-width: 760px) {
    .manifesto { gap: 22px; text-align: left; align-items: flex-start; }
    .manifesto__headline { font-size: clamp(40px, 12vw, 60px); }
    .manifesto__support p { font-size: 18px; line-height: 1.75; }
  }
</style>
