---
import Button from "./Button.astro";
import { workedWith, featuredImages } from "../data/site";
import { getLang, getT, localePath } from "../i18n/utils";

const lang = getLang(Astro);
const t = getT(lang);
const lp = (p: string) => localePath(lang, p);
---
<div class="about-teaser">
  <figure class="about-teaser__media">
    <img src={featuredImages.aboutTeaser} alt="Super Plage live — Francos" loading="lazy" />
  </figure>

  <div class="about-teaser__content">
    <p class="eyebrow">{t.about.eyebrow}</p>
    <h2 class="about-teaser__title">{t.about.title}</h2>

    <div class="about-teaser__text">
      {t.about.teaserParagraphs.map((p) => <p>{p}</p>)}
    </div>

    <div class="about-teaser__worked">
      <p class="eyebrow eyebrow--small">{t.about.workedWithLabel}</p>
      <p class="about-teaser__brands">
        {workedWith.join(" · ")}<br />
        {t.about.workedWithSuffix}
      </p>
    </div>

    <Button href={lp("/about")}>{t.cta.moreAboutMe}</Button>
  </div>
</div>

<style>
  .about-teaser {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }
  .about-teaser__media {
    margin: 0;
    max-width: 480px;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    overflow: hidden;
    background: #0e0e0e;
  }
  .about-teaser__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .about-teaser__content { display: flex; flex-direction: column; gap: 24px; max-width: 560px; }

  .eyebrow {
    font-size: 11px;
    letter-spacing: var(--ls-extra);
    text-transform: uppercase;
    color: var(--color-text-mute);
    margin: 0;
  }
  .eyebrow--small { font-size: 10px; }

  .about-teaser__title {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.005em;
    line-height: 0.95;
  }
  .about-teaser__text { display: flex; flex-direction: column; gap: 12px; color: var(--color-text-dim); line-height: 1.7; font-size: 14px; }
  .about-teaser__text p { margin: 0; }

  .about-teaser__worked { display: flex; flex-direction: column; gap: 8px; padding: 16px 0; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
  .about-teaser__brands { margin: 0; font-size: 13px; color: var(--color-text-dim); line-height: 1.7; }

  @media (max-width: 900px) {
    .about-teaser { grid-template-columns: 1fr; }
    .about-teaser__media { order: -1; max-width: 100%; }
  }
  @media (max-width: 760px) {
    .about-teaser__title { font-size: clamp(44px, 12vw, 64px); }
    .about-teaser__text { font-size: 16px; line-height: 1.75; }
    .about-teaser__brands { font-size: 15px; line-height: 1.7; }
    .about-teaser .eyebrow { font-size: 12px; }
  }
</style>
