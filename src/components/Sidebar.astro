---
import Logo from "./Logo.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { site } from "../data/site";
import { getLang, getT, localePath } from "../i18n/utils";

const lang = getLang(Astro);
const t = getT(lang);
const lp = (p: string) => localePath(lang, p);

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const navItems = [
  { label: t.nav.home,     href: lp("/") },
  { label: t.nav.about,    href: lp("/about") },
  { label: t.nav.work,     href: lp("/work") },
  { label: t.nav.services, href: lp("/services") },
  { label: t.nav.contact,  href: lp("/contact") },
];
---
<aside class="sidebar" aria-label="Primary">
  <div class="sidebar__top">
    <a href={lp("/")} class="brand" aria-label={`${site.name} — home`}>
      <Logo size={40} />
      <span class="brand__name">{site.name}</span>
    </a>
    <p class="brand__person">{site.owner}</p>
    <p class="brand__role">{t.role}</p>
    <p class="brand__city">{t.city}</p>

    <nav class="nav" aria-label="Main navigation">
      <ul>
        {navItems.map((item) => {
          const itemPath = item.href.replace(/\/$/, "") || "/";
          const isActive = currentPath === itemPath;
          return (
            <li>
              <a
                href={item.href}
                class:list={["nav__link", { "is-active": isActive }]}
                aria-current={isActive ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>

  <div class="sidebar__bottom">
    <LanguageSwitcher />
    <div class="sidebar__socials">
      <a href={site.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="icon-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="5"/>
          <circle cx="12" cy="12" r="4"/>
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
        </svg>
      </a>
      <a href={`mailto:${site.email}`} aria-label="Email" class="icon-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="5" width="18" height="14" rx="2"/>
          <path d="m3 7 9 6 9-6"/>
        </svg>
      </a>
    </div>
  </div>
</aside>

<style>
  .sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    width: var(--sidebar-w);
    padding: 28px 22px;
    border-right: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: linear-gradient(180deg, #050505 0%, #000 100%);
    z-index: 20;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }
  .brand__name {
    font-family: var(--font-display);
    font-size: 20px;
    letter-spacing: 0.08em;
  }
  .brand__person { font-size: 13px; margin: 6px 0 2px; }
  .brand__role,
  .brand__city {
    font-size: 12px;
    color: var(--color-text-mute);
    margin: 0;
    line-height: 1.5;
  }

  .nav { margin-top: 40px; }
  .nav ul { display: flex; flex-direction: column; gap: 4px; }
  .nav__link {
    display: block;
    padding: 8px 0;
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-text-mute);
    position: relative;
    transition: color var(--dur-fast) var(--ease), padding-left var(--dur) var(--ease);
  }
  .nav__link::before {
    content: "";
    position: absolute;
    left: 0; top: 50%;
    width: 0; height: 1px;
    background: var(--color-text);
    transform: translateY(-50%);
    transition: width var(--dur) var(--ease);
  }
  .nav__link:hover {
    color: var(--color-text);
    padding-left: 14px;
  }
  .nav__link:hover::before { width: 8px; }
  .nav__link.is-active {
    color: var(--color-text);
    padding-left: 14px;
  }
  .nav__link.is-active::before { width: 8px; }

  .sidebar__bottom {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .sidebar__socials { display: flex; gap: 10px; }
  .icon-btn {
    width: 32px; height: 32px;
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: 8px;
    color: var(--color-text-mute);
    transition: color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
  }
  .icon-btn:hover { color: var(--color-text); background: rgba(255, 255, 255, 0.05); }

  @media (max-width: 760px) {
    .sidebar { display: none; }
  }
</style>
