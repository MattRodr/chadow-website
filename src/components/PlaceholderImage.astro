---
interface Props {
  hue?: number;
  sat?: number;
  ratio?: string;
  label?: string;
  rounded?: boolean;
  class?: string;
}
const {
  hue = 220,
  sat = 25,
  ratio = "4 / 5",
  label = "",
  rounded = true,
  class: className = "",
} = Astro.props;

const id = `ph-${Math.random().toString(36).slice(2, 9)}`;
---
<div
  class:list={["ph", { "ph--rounded": rounded }, className]}
  style={`aspect-ratio: ${ratio};`}
  aria-label={label}
>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 500" preserveAspectRatio="xMidYMid slice">
    <defs>
      <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%"   stop-color={`hsl(${hue}, ${sat}%, 22%)`} />
        <stop offset="100%" stop-color={`hsl(${hue}, ${Math.min(sat + 10, 60)}%, 6%)`} />
      </linearGradient>
    </defs>
    <rect width="400" height="500" fill={`url(#${id})`} />
    <circle cx="200" cy="240" r="100" fill={`hsl(${hue}, ${sat + 30}%, 45%)`} opacity="0.3" />
  </svg>
</div>

<style>
  .ph {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #0e0e0e;
  }
  .ph--rounded { border-radius: var(--radius); }
  .ph svg {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
  }
</style>
