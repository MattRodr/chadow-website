---
import Logo from "./Logo.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { site } from "../data/site";
import { getLang, getT, localePath } from "../i18n/utils";

const lang = getLang(Astro);
const t = getT(lang);
const lp = (p: string) => localePath(lang, p);

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const navItems = [
  { label: t.nav.home,     href: lp("/") },
  { label: t.nav.about,    href: lp("/about") },
  { label: t.nav.work,     href: lp("/work") },
  { label: t.nav.services, href: lp("/services") },
  { label: t.nav.contact,  href: lp("/contact") },
];
---
<header class="topbar" aria-label="Mobile header">
  <a href={lp("/")} class="brand">
    <Logo size={30} />
    <span class="brand__name">{site.name}</span>
  </a>
  <button class="menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
    <span></span><span></span><span></span>
  </button>
</header>

<div id="mobile-nav" class="mobile-nav" aria-hidden="true">
  <nav class="mobile-nav__inner" aria-label="Mobile navigation">
    <ul>
      {navItems.map((item) => {
        const itemPath = item.href.replace(/\/$/, "") || "/";
        const isActive = currentPath === itemPath;
        return (
          <li>
            <a href={item.href} class:list={["mobile-nav__link", { "is-active": isActive }]}>
              {item.label}
            </a>
          </li>
        );
      })}
    </ul>

    <div class="mobile-nav__footer">
      <p class="mobile-nav__person">{site.owner}</p>
      <p class="mobile-nav__role">{t.role} · {t.city}</p>
      <div class="mobile-nav__row">
        <LanguageSwitcher />
        <div class="mobile-nav__socials">
          <a href={site.instagram} target="_blank" rel="noopener" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
          </a>
          <a href={`mailto:${site.email}`} aria-label="Email">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          </a>
        </div>
      </div>
    </div>
  </nav>
</div>

<script>
  function setupMobileMenu() {
    const btn = document.querySelector<HTMLButtonElement>(".menu-btn");
    const drawer = document.getElementById("mobile-nav");
    if (!btn || !drawer) return;
    if (btn.dataset.bound === "1") return;
    btn.dataset.bound = "1";

    const open = () => {
      btn.setAttribute("aria-expanded", "true");
      btn.setAttribute("aria-label", "Close menu");
      drawer.setAttribute("aria-hidden", "false");
      drawer.classList.add("is-open");
      document.body.style.overflow = "hidden";
    };
    const close = () => {
      btn.setAttribute("aria-expanded", "false");
      btn.setAttribute("aria-label", "Open menu");
      drawer.setAttribute("aria-hidden", "true");
      drawer.classList.remove("is-open");
      document.body.style.overflow = "";
    };
    const toggle = () => {
      if (btn.getAttribute("aria-expanded") === "true") close();
      else open();
    };

    btn.addEventListener("click", toggle);
    drawer.querySelectorAll<HTMLAnchorElement>("a").forEach((a) => {
      a.addEventListener("click", close);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && btn.getAttribute("aria-expanded") === "true") close();
    });
  }

  document.addEventListener("astro:page-load", setupMobileMenu);
  setupMobileMenu();
</script>

<style>
  .topbar {
    display: none;
    position: sticky;
    top: 0;
    z-index: 60;
    padding: 14px 18px;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    align-items: center;
    justify-content: space-between;
  }
  .brand { display: flex; align-items: center; gap: 10px; }
  .brand__name { font-family: var(--font-display); font-size: 16px; letter-spacing: 0.08em; }

  .menu-btn {
    width: 36px; height: 36px;
    display: inline-flex; flex-direction: column; justify-content: center; align-items: center;
    gap: 5px;
    position: relative;
    z-index: 61;
  }
  .menu-btn span {
    width: 22px;
    height: 1.5px;
    background: #fff;
    transition: transform var(--dur) var(--ease), opacity var(--dur-fast) var(--ease);
    transform-origin: center;
  }
  .menu-btn[aria-expanded="true"] span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .menu-btn[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .menu-btn[aria-expanded="true"] span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  .mobile-nav {
    display: none;
    position: fixed;
    inset: 64px 0 0 0;
    z-index: 55;
    background: rgba(0, 0, 0, 0.96);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--dur) var(--ease), visibility 0s linear var(--dur);
    overflow-y: auto;
  }
  .mobile-nav.is-open {
    opacity: 1;
    visibility: visible;
    transition: opacity var(--dur) var(--ease), visibility 0s;
  }

  .mobile-nav__inner {
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 24px 22px 32px;
    gap: 28px;
  }
  .mobile-nav ul { display: flex; flex-direction: column; gap: 0; }
  .mobile-nav__link {
    display: block;
    padding: 18px 0;
    font-family: var(--font-display);
    font-size: 32px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-text-mute);
    border-bottom: 1px solid var(--color-border);
    transition: color var(--dur-fast) var(--ease);
    transform: translateY(8px);
    opacity: 0;
  }
  .mobile-nav.is-open .mobile-nav__link {
    transform: translateY(0);
    opacity: 1;
    transition:
      color var(--dur-fast) var(--ease),
      transform 600ms cubic-bezier(.2,.7,.2,1),
      opacity 600ms cubic-bezier(.2,.7,.2,1);
  }
  .mobile-nav.is-open ul li:nth-child(1) .mobile-nav__link { transition-delay: 60ms; }
  .mobile-nav.is-open ul li:nth-child(2) .mobile-nav__link { transition-delay: 120ms; }
  .mobile-nav.is-open ul li:nth-child(3) .mobile-nav__link { transition-delay: 180ms; }
  .mobile-nav.is-open ul li:nth-child(4) .mobile-nav__link { transition-delay: 240ms; }
  .mobile-nav.is-open ul li:nth-child(5) .mobile-nav__link { transition-delay: 300ms; }

  .mobile-nav__link.is-active { color: var(--color-text); }
  .mobile-nav ul li:last-child .mobile-nav__link { border-bottom: 0; }

  .mobile-nav__footer {
    margin-top: auto;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .mobile-nav__person { font-size: 13px; color: var(--color-text); margin: 0; }
  .mobile-nav__role { font-size: 12px; color: var(--color-text-mute); margin: 0 0 14px; }
  .mobile-nav__row { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .mobile-nav__socials { display: flex; gap: 14px; }
  .mobile-nav__socials a {
    width: 36px; height: 36px;
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: 8px;
    color: var(--color-text-mute);
    border: 1px solid var(--color-border);
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }
  .mobile-nav__socials a:hover { color: var(--color-text); border-color: var(--color-border-strong); }

  @media (max-width: 760px) {
    .topbar { display: flex; }
    .mobile-nav { display: block; }
  }
</style>
