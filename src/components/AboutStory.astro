---
import { workedWith } from "../data/site";
import { getLang, getT } from "../i18n/utils";
const lang = getLang(Astro);
const t = getT(lang);
const s = t.about.story;
const paragraphs = [...s.lead, ...s.body];
---
<div class="story">
  <div class="story__grid">
    <!-- Colonne gauche : titre + signature de marque -->
    <aside class="story__aside" data-reveal>
      <p class="story__label">{s.label}</p>
      <p class="story__tagline">{s.tagline}</p>
      <p class="story__tagline-sub">{s.taglineSub}</p>
    </aside>

    <!-- Colonne droite : le récit -->
    <div class="story__body" data-reveal data-reveal-delay="100">
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </div>

  <!-- Bande : ils m'ont fait confiance -->
  <div class="story__worked" data-reveal>
    <p class="story__worked-label">{t.about.workedWithLabel}</p>
    <p class="story__brands">{workedWith.join("  ·  ")}</p>
    <p class="story__worked-suffix">{t.about.workedWithSuffix}</p>
  </div>
</div>

<style>
  .story { display: flex; flex-direction: column; gap: clamp(40px, 6vw, 72px); }

  .story__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }

  /* Colonne gauche */
  .story__aside {
    display: flex;
    flex-direction: column;
    gap: 18px;
    position: sticky;
    top: 48px;
  }
  .story__label {
    margin: 0;
    font-size: 11px;
    letter-spacing: var(--ls-extra);
    text-transform: uppercase;
    color: var(--color-text-mute);
  }
  .story__tagline {
    margin: 0;
    padding-left: 18px;
    border-left: 2px solid var(--color-border-strong);
    font-family: var(--font-display);
    font-size: clamp(30px, 3.2vw, 40px);
    line-height: 1.02;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }
  .story__tagline-sub {
    margin: 0;
    padding-left: 18px;
    font-size: clamp(15px, 1.4vw, 16px);
    line-height: 1.65;
    color: var(--color-text-dim);
    max-width: 38ch;
  }

  /* Colonne droite */
  .story__body { display: flex; flex-direction: column; gap: 18px; max-width: 60ch; }
  .story__body p {
    margin: 0;
    font-size: clamp(15px, 1.5vw, 17px);
    line-height: 1.8;
    color: var(--color-text-dim);
  }
  .story__body p:first-child { color: var(--color-text); }

  /* Bande confiance */
  .story__worked {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
    padding-top: clamp(32px, 5vw, 56px);
    border-top: 1px solid var(--color-border);
  }
  .story__worked-label {
    margin: 0;
    font-size: 10px;
    letter-spacing: var(--ls-extra);
    text-transform: uppercase;
    color: var(--color-text-mute);
  }
  .story__brands {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(26px, 2.8vw, 34px);
    line-height: 1.25;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    max-width: 22ch;
  }
  .story__worked-suffix { margin: 0; font-size: 13px; color: var(--color-text-mute); }

  @media (max-width: 1024px) {
    .story__grid { grid-template-columns: 1fr; gap: 28px; }
    .story__aside { position: static; }
  }
  @media (max-width: 760px) {
    .story__body p { font-size: 17px; line-height: 1.75; }
    .story__tagline { font-size: 34px; }
    .story__tagline-sub { font-size: 16px; }
    .story__brands { font-size: 30px; }
    .story__worked-label { font-size: 12px; }
    .story__worked-suffix { font-size: 14px; }
  }
</style>
