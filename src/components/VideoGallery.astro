---
import { videos } from "../data/site";
import { getLang, getT } from "../i18n/utils";
const lang = getLang(Astro);
const t = getT(lang);

type Parsed = {
  provider: "youtube" | "vimeo" | null;
  id: string | null;
  embed: string | null;
  thumb: string | null;
};

/** Extrait fournisseur + id depuis un lien YouTube ou Vimeo collé tel quel. */
function parse(url: string): Parsed {
  const u = (url || "").trim();
  const yt =
    u.match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/|live\/)|youtu\.be\/)([\w-]{6,})/i);
  if (yt) {
    const id = yt[1];
    return {
      provider: "youtube",
      id,
      embed: `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`,
      thumb: `https://i.ytimg.com/vi/${id}/hqdefault.jpg`,
    };
  }
  const vm = u.match(/vimeo\.com\/(?:video\/)?(\d+)/i);
  if (vm) {
    const id = vm[1];
    return {
      provider: "vimeo",
      id,
      embed: `https://player.vimeo.com/video/${id}?autoplay=1`,
      thumb: null, // Vimeo nécessite une miniature fournie (poster) côté CMS
    };
  }
  return { provider: null, id: null, embed: null, thumb: null };
}

const items = videos
  .map((v) => ({ ...v, ...parse(v.url) }))
  .filter((v) => v.embed); // ignore les liens non reconnus
---
{items.length === 0 ? (
  <p class="video-empty">{t.video.empty}</p>
) : (
  <div class="video-grid">
    {items.map((v) => (
      <figure class="video-card">
        <button
          class="video-card__btn"
          data-embed={v.embed}
          aria-label={`${t.video.watch} — ${v.title}`}
        >
          {(v.poster || v.thumb) ? (
            <img class="video-card__thumb" src={v.poster || v.thumb} alt={v.title} loading="lazy" />
          ) : (
            <span class="video-card__thumb video-card__thumb--blank" aria-hidden="true"></span>
          )}
          <span class="video-card__play" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          </span>
        </button>
        <figcaption class="video-card__meta">
          <span class="video-card__title">{v.title}</span>
          {v.context && <span class="video-card__context">{v.context}</span>}
        </figcaption>
      </figure>
    ))}
  </div>
)}

<script>
  function setupVideos() {
    document.querySelectorAll<HTMLButtonElement>(".video-card__btn").forEach((btn) => {
      if (btn.dataset.bound === "1") return;
      btn.dataset.bound = "1";
      btn.addEventListener("click", () => {
        const embed = btn.dataset.embed;
        if (!embed) return;
        const iframe = document.createElement("iframe");
        iframe.src = embed;
        iframe.title = btn.getAttribute("aria-label") || "Video";
        iframe.allow =
          "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
        iframe.allowFullscreen = true;
        iframe.loading = "lazy";
        iframe.className = "video-card__iframe";
        btn.replaceWith(iframe);
      });
    });
  }
  document.addEventListener("astro:page-load", setupVideos);
  setupVideos();
</script>

<style>
  .video-empty {
    margin: 0;
    font-size: 15px;
    color: var(--color-text-mute);
    letter-spacing: 0.02em;
  }

  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 360px), 1fr));
    gap: clamp(18px, 2.4vw, 32px);
  }

  .video-card { margin: 0; display: flex; flex-direction: column; gap: 12px; }

  .video-card__btn,
  :global(.video-card__iframe) {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: var(--radius);
    overflow: hidden;
    background: #0e0e0e;
  }
  .video-card__btn { cursor: pointer; padding: 0; }

  .video-card__thumb {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1000ms cubic-bezier(.2,.7,.2,1), filter var(--dur) var(--ease);
  }
  .video-card__thumb--blank {
    background: radial-gradient(120% 120% at 30% 20%, #1a1a1a 0%, #000 70%);
  }
  .video-card__btn:hover .video-card__thumb { transform: scale(1.04); filter: brightness(0.8); }

  .video-card__play {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 64px; height: 64px;
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid var(--color-border-strong);
    color: var(--color-text);
    transition: transform var(--dur) var(--ease), background var(--dur-fast) var(--ease);
  }
  .video-card__btn:hover .video-card__play { transform: translate(-50%, -50%) scale(1.08); background: rgba(0, 0, 0, 0.7); }
  .video-card__play svg { margin-left: 3px; }

  .video-card__meta { display: flex; flex-direction: column; gap: 3px; }
  .video-card__title { font-size: 14px; color: var(--color-text); letter-spacing: 0.02em; }
  .video-card__context { font-size: 12px; color: var(--color-text-mute); letter-spacing: 0.04em; }
</style>
